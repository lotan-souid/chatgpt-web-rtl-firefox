{
  "manifest_version": 3,
  "name": "ChatGPT Web RTL",
  "version": "0.4.2",
  "description": "Adds automatic right-to-left support for Hebrew and mixed Hebrew/English conversations in ChatGPT, Claude, Gemini and other AI chats.",
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-web-rtl-firefox@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*",
        "https://chat.qwenlm.ai/*",
        "https://grok.com/*",
        "https://chat.mistral.ai/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://poe.com/*",
        "https://duck.ai/*"
      ],
      "css": [
        "src/content.css"
      ],
      "js": [
        "src/settings.js",
        "src/sites.js",
        "src/direction.js",
        "src/toggle.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "background": {
    "scripts": [
      "src/settings.js",
      "src/background.js"
    ]
  },
  "action": {
    "default_title": "ChatGPT Web RTL",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "commands": {
    "toggle-rtl": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Toggle ChatGPT Web RTL on the current page"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
